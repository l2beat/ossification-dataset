{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exploit incident",
  "description": "Claims about one exploit. The file path incidents/<chainId>/<exploitTx>.json names the earliest exploit transaction; onchain facts are derived into dist/.",
  "type": "object",
  "required": ["$schema", "protocol", "name", "summary", "targets", "loss"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "../../schema/incident.schema.json" },
    "protocol": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "description": "The defect and how it was exploited." },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" },
      "description": "Executed contracts carrying the defect; the one with the latest reset sets the age."
    },
    "loss": { "$ref": "#/$defs/loss" },
    "campaign": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          { "type": "string", "pattern": "^eip155:[1-9][0-9]*:0x[0-9a-f]{64}$" },
          { "$ref": "#/$defs/bundle" }
        ]
      },
      "description": "Every further exploit transaction of the incident: transaction ids, or bundles for large copycat tails."
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(https?://\\S+|eip155:[1-9][0-9]*:0x[0-9a-f]{64})$" },
      "description": "Sources and evidence: write-ups, proof-of-concept code, and transactions that are not exploits of this incident, such as the fix, a rescue or an earlier failed attempt."
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Reasons for choices a reader could question."
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "target": {
      "type": "object",
      "required": ["address", "reset"],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/address", "description": "Execution address, supplying storage and authority." },
        "code": { "$ref": "#/$defs/address", "description": "Delegated code with the defect: implementation, facet, module or library. Omitted when the address runs its own code." },
        "reset": { "$ref": "#/$defs/reset" }
      }
    },
    "reset": {
      "description": "The latest change before the exploit that established the vulnerable code or state.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "tx"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "deployment" }, "tx": { "$ref": "#/$defs/hash" } },
          "description": "tx created the target address."
        },
        {
          "type": "object",
          "required": ["kind", "tx"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "upgrade" }, "tx": { "$ref": "#/$defs/hash" } },
          "description": "tx made the system run the target code: a proxy, beacon, diamond, router or registry now points to it."
        },
        {
          "type": "object",
          "required": ["kind", "tx", "address"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "config" },
            "tx": { "$ref": "#/$defs/hash" },
            "address": { "$ref": "#/$defs/address" },
            "slot": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
            "call": { "type": "string", "pattern": "^0x[0-9a-f]{8}(?:[0-9a-f]{64})*$" }
          },
          "oneOf": [{ "required": ["slot"] }, { "required": ["call"] }],
          "description": "tx changed the storage slot, or the view call result, of address."
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "genesis" } },
          "description": "The code has been in place since block zero."
        }
      ]
    },
    "bundle": {
      "type": "object",
      "required": ["chainId", "count", "from", "to", "selection"],
      "additionalProperties": false,
      "properties": {
        "chainId": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 0 },
        "selection": { "type": "string", "minLength": 1 }
      },
      "description": "count transactions in blocks from..to, reproducible from the selection rule."
    },
    "loss": {
      "type": "object",
      "description": "Gross victim depletion by asset (rule 11); usd is the sum of the assets' usd.",
      "required": ["usd", "assets"],
      "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "minimum": 1000 },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usd"],
      "anyOf": [{ "required": ["token"] }, { "required": ["symbol"] }],
      "properties": {
        "chainId": { "type": "integer", "minimum": 1, "description": "Only when it differs from the incident chain." },
        "token": { "$ref": "#/$defs/address" },
        "symbol": { "type": "string", "minLength": 1 },
        "amount": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "usd": { "type": "number", "minimum": 0, "description": "0 when the asset realised nothing (rule 12)." }
      }
    }
  }
}
